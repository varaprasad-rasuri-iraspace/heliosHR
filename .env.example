# Copy to .env for local runs. Never commit the populated .env file.

# Optional live model configuration. Keep keys blank; add your own provider key.
# Set HELIOS_MODEL to provider/model-id, for example:
#   anthropic/your-model-id  + ANTHROPIC_API_KEY
#   openai/your-model-id     + OPENAI_API_KEY
#   gemini/your-model-id     + GEMINI_API_KEY
# Without both a model and its matching key, the offline mock is used.
HELIOS_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# MCP server defaults to local stdio without authentication.
MCP_TRANSPORT=stdio
MCP_AUTH=off
MCP_PUBLIC_URL=https://mcp.internal.helioshr.com
OKTA_ISSUER=https://helioshr.okta.com/oauth2/default
OKTA_JWKS_URL=https://helioshr.okta.com/oauth2/default/v1/keys
AUDIT_PATH=prototype/audit_mcp.jsonl
STATE_DB_PATH=prototype/onboarding_state.sqlite3

# Used by the n8n webhook verification code when configured in the n8n host.
# The Python .env loader does not inject variables into a separate n8n process.
WORKDAY_WEBHOOK_SECRET=
